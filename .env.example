# Used directly when running the app without Docker (venv + local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Used by docker-compose.yml to provision the `db` container — keep these
# consistent with the user/password/dbname encoded in DATABASE_URL above
# when running via `docker compose up` (DATABASE_URL there should point to
# host "db" instead of "localhost", with special characters percent-encoded)
POSTGRES_DB=dbname
POSTGRES_USER=user
POSTGRES_PASSWORD=password

SECRET_KEY=your-secret-key-here
BASE_DOMAIN=yourapp.com
BACKEND_CORS_ORIGINS=*
SUPERADMIN_EMAIL=superadmin@yourapp.com
SUPERADMIN_PASSWORD=QD0LA6WbHjPS-cOS
